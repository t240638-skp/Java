pipeline {
    agent any
stages {
        stage('Clone') {
            steps {
              git branch: 'main', url: 'https://github.com/t240638-skp/Java.git'
            }
        }

        stage('Compile') {
            steps {
               bat 'javac Hello.java'
            }
        }
            stage('Run') {
            steps {
               bat 'java Hello'
            }
        }
    }
}

